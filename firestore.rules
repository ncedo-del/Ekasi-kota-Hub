rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Owners collection (Public reads shop info; owner updates own profile)
    match /owners/{ownerId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == ownerId;
    }

    // Menu items collection (Public reads available items or owner reads all; owner manages menu)
    match /menu_items/{itemId} {
      allow read: if resource.data.available == true || (request.auth != null && request.auth.uid == resource.data.owner_id);
      allow create: if request.auth != null && request.resource.data.owner_id == request.auth.uid;
      allow update: if request.auth != null && resource.data.owner_id == request.auth.uid;
      allow delete: if request.auth != null && resource.data.owner_id == request.auth.uid;
    }

    // Orders collection (Orders created ONLY via Cloud Function placeOrder. Owner can read/update own orders)
    match /orders/{orderId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.owner_id;
      allow update: if request.auth != null && request.auth.uid == resource.data.owner_id;
      allow create: if false; // Must be created via Cloud Function
      allow delete: if request.auth != null && resource.data.owner_id == request.auth.uid;
    }

    // Rate limits and order counter documents (Cloud Function / Admin access only)
    match /order_rate_limits/{docId} {
      allow read, write: if false;
    }
    match /order_counters/{ownerId} {
      allow read, write: if false;
    }
  }
}
